# Production secrets are read from .env.production.local (untracked — never commit it).
# Kamal 2 removed dotenv auto-loading, so a bare `kamal deploy` sees an empty
# environment unless the file is sourced first. Reading it explicitly here means
# `kamal deploy` works on its own and no token ever lands in git.
#
# NOTE: Kamal's secrets parser supports $(command) substitution but NOT bash
# ${VAR:-default} syntax — it silently emits the literal ":-...}" around the
# expansion, producing a corrupt value. Use plain $(...) only.

KAMAL_REGISTRY_PASSWORD=$(grep -m1 '^KAMAL_REGISTRY_PASSWORD=' .env.production.local | cut -d= -f2-)
RAILS_MASTER_KEY=$(cat config/master.key)
DB_PASSWORD=$(grep -m1 '^DB_PASSWORD=' .env.production.local | cut -d= -f2-)
POSTGRES_PASSWORD=$DB_PASSWORD
ANTHROPIC_API_KEY=$(grep -m1 '^ANTHROPIC_API_KEY=' .env.production.local | cut -d= -f2-)
GMAIL_USERNAME=$(grep -m1 '^GMAIL_USERNAME=' .env.production.local | cut -d= -f2-)
GMAIL_PASSWORD=$(grep -m1 '^GMAIL_PASSWORD=' .env.production.local | cut -d= -f2-)
ADMIN_PASSWORD=$(grep -m1 '^ADMIN_PASSWORD=' .env.production.local | cut -d= -f2-)
