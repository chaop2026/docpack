#!/usr/bin/env bash
#
# bin/admin-password-reset — ADMIN_PASSWORD 를 새 값으로 교체한다 (S15, 2026-11-07)
#
# 사용법:  bin/admin-password-reset
# 문서:    docs/ADMIN_PASSWORD_RESET.md
#
# ── 이 스크립트의 규칙 ────────────────────────────────────────────────────────
#
# 1. 새 비밀번호를 **화면에 출력하지 않는다.** 클립보드(pbcopy)로만 전달한다.
#    터미널 스크롤백·`script` 로그·세션 기록은 전부 영구적이고, 비밀번호가 거기
#    남으면 교체한 의미가 없다. 확인은 길이와 문자 종류로만 한다.
#
# 2. **지우지 않는다.** 이 스크립트에는 `rm` 이 없다. 원본은 백업한 뒤
#    원자적 `mv` 로 교체하고, 중간에 실패하면 임시 파일을 **남긴 채** 그 경로를
#    알린다. 되돌릴 수 없는 삭제는 사람이 한다
#    (~/.claude/CLAUDE.md 「삭제 안전 정책」).
#
# 3. **다른 줄을 건드리지 않는다.** 교체 전후로 ① ADMIN_PASSWORD 를 제외한
#    나머지 줄의 SHA-256 ② 줄 수 ③ ADMIN_PASSWORD 줄의 개수를 대조하고, 하나라도
#    어긋나면 교체하지 않는다. 비밀값이 든 파일에서 "아마 괜찮을 것" 은 근거가
#    아니다.
#
# 4. **배포는 배포 전용 폴더에서만.** 아래 DEPLOY 절 참조.
#
# 테스트용 훅 (test/scripts/admin_password_reset_test.rb 가 쓴다):
#   ADMIN_PASSWORD_RESET_ENV_FILE  대상 env 파일 경로를 바꾼다
#   ADMIN_PASSWORD_RESET_PBCOPY    pbcopy 대신 실행할 명령
#   ADMIN_PASSWORD_RESET_DEPLOY_DIR 배포 전용 폴더 경로를 바꾼다

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

ENV_FILE="${ADMIN_PASSWORD_RESET_ENV_FILE:-$ROOT/.env.production.local}"
PBCOPY="${ADMIN_PASSWORD_RESET_PBCOPY:-pbcopy}"
DEPLOY_DIR="${ADMIN_PASSWORD_RESET_DEPLOY_DIR:-$HOME/Projects/docpack-deploy}"

STAMP="$(date '+%Y%m%d-%H%M%S')"
BACKUP="${ENV_FILE}.bak-${STAMP}"
STAGED="${ENV_FILE}.s15-staged-$$"

die() { printf '%s\n' "✗ $*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

say "ADMIN_PASSWORD 재설정"
say "대상 파일: $ENV_FILE"
say ""

# ── 0. 전제 ───────────────────────────────────────────────────────────────────

for tool in openssl awk shasum cp mv chmod; do
  command -v "$tool" >/dev/null 2>&1 || die "필요한 명령이 없습니다: $tool"
done

if [ ! -f "$ENV_FILE" ]; then
  say "✗ $ENV_FILE 이 없습니다."
  say ""
  say "  이 파일은 커밋되지 않는 프로덕션 비밀값 파일입니다(.gitignore 의 /.env*)."
  say "  맥북에만 있고, 사라졌다면 이 스크립트가 복구할 수 있는 것이 아닙니다."
  say ""
  say "  확인할 곳:"
  say "    1) 같은 폴더의 백업   ls -la $ROOT/.env.production.local.bak-*"
  say "    2) Bitwarden 에 보관된 프로덕션 비밀값"
  say "    3) 서버에 살아 있는 값 (kamal app exec 'printenv ADMIN_PASSWORD' 은"
  say "       값을 터미널에 출력하므로 권하지 않습니다)"
  say ""
  say "  파일을 되살린 뒤 이 스크립트를 다시 실행하세요."
  exit 1
fi

[ -r "$ENV_FILE" ] || die "$ENV_FILE 을 읽을 수 없습니다 (권한)."
[ -w "$ENV_FILE" ] || die "$ENV_FILE 에 쓸 수 없습니다 (권한)."

if [ -e "$BACKUP" ] || [ -e "$STAGED" ]; then
  die "작업 파일이 이미 존재합니다: $BACKUP / $STAGED — 직접 확인해 주세요."
fi

# ── 1. .gitignore 확인 ────────────────────────────────────────────────────────
#
# 대상이 저장소 밖이어도(테스트) 저장소의 규칙은 확인한다 — 커밋될 수 있는지는
# ENV_FILE 이 어디를 가리키는지와 무관하게 .gitignore 가 정한다.

ensure_ignored() {
  local candidate="$1" label="$2"
  # git 이 없거나 여기가 작업 트리가 아니면 **추가하지 않는다.** check-ignore 의
  # 실패를 "무시되지 않음" 으로 읽으면, 판정할 수 없는 상태에서 .gitignore 에
  # 규칙을 쓰게 된다 — 비밀값 파일을 다루는 스크립트가 저장소 파일을 추측으로
  # 고치는 것은 이 도구가 하려는 일의 반대다.
  if ! git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    say "  ⚠ git 작업 트리가 아니어서 .gitignore 를 확인하지 못했습니다 ($label) — 추가하지 않습니다"
    return 0
  fi
  if git -C "$ROOT" check-ignore -q "$candidate" 2>/dev/null; then
    say "  ✓ .gitignore 가 $label 를 무시합니다"
    return 0
  fi
  say "  + .gitignore 에 $label 규칙을 추가합니다"
  {
    printf '\n# 프로덕션 비밀값과 bin/admin-password-reset 의 백업 (S15)\n'
    printf '%s\n' "$3"
  } >> "$ROOT/.gitignore"
  git -C "$ROOT" check-ignore -q "$candidate" 2>/dev/null \
    || die ".gitignore 에 규칙을 넣었지만 여전히 무시되지 않습니다: $candidate"
}

say "[1/6] .gitignore"
ensure_ignored ".env.production.local" ".env.production.local" "/.env*"
ensure_ignored ".env.production.local.bak-19700101-000000" "백업 파일(.env*.bak-*)" "/.env*.bak-*"

# ── 2. 교체 전 지문 ───────────────────────────────────────────────────────────
#
# wc -l 이 아니라 awk END{NR}: wc 는 개행을 세므로 마지막 줄에 개행이 없으면 한
# 줄을 덜 센다. 지금 보려는 것은 "줄" 이다.

say "[2/6] 교체 전 상태를 기록합니다"

other_sha() { grep -v '^ADMIN_PASSWORD=' "$1" | shasum -a 256 | awk '{print $1}'; }
line_count() { awk 'END { print NR }' "$1"; }
key_count() { grep -c '^ADMIN_PASSWORD=' "$1" || true; }

BEFORE_OTHER_SHA="$(other_sha "$ENV_FILE")"
BEFORE_LINES="$(line_count "$ENV_FILE")"
BEFORE_KEYS="$(key_count "$ENV_FILE")"
WHOLE_SHA="$(shasum -a 256 "$ENV_FILE" | awk '{print $1}')"
# stat -f: BSD/macOS (운영 대상). stat -c: GNU/Linux (컨테이너 테스트).
FILE_MODE="$(stat -f '%Lp' "$ENV_FILE" 2>/dev/null || stat -c '%a' "$ENV_FILE" 2>/dev/null || echo 600)"

say "  줄 수 $BEFORE_LINES · ADMIN_PASSWORD 줄 $BEFORE_KEYS 개 · 권한 $FILE_MODE"

if [ "$BEFORE_KEYS" -gt 1 ]; then
  die "ADMIN_PASSWORD 줄이 $BEFORE_KEYS 개입니다. 어느 줄이 유효한지 기계가 정할 수 없습니다 — 직접 정리한 뒤 다시 실행하세요."
fi

# 마지막 줄에 개행이 없으면 awk 가 출력할 때 하나 붙는다. 바이트가 변하는 유일한
# 지점이므로 조용히 넘기지 않고 알린다.
ADDS_NEWLINE=0
if [ -n "$(tail -c 1 "$ENV_FILE")" ]; then
  ADDS_NEWLINE=1
  say "  ⚠ 마지막 줄에 개행이 없습니다 — 교체본에는 개행이 추가됩니다(내용 변화 없음)."
fi

# 마지막 자리가 4~7 이면 other 에 읽기 비트가 있다. 5(=r-x) 도 읽을 수 있다.
case "$FILE_MODE" in
  *[4-7])
    say "  ⚠ 권한 $FILE_MODE — 다른 사용자가 읽을 수 있습니다. chmod 600 을 권합니다." ;;
esac

# ── 3. 새 비밀번호 ────────────────────────────────────────────────────────────
#
# openssl rand(암호학적 난수) → base64 → 영숫자만 남김 → 32자.
# 영숫자로 제한하는 이유는 강도가 아니라 운반이다: 이 값은 .env 한 줄에 들어가고
# Kamal 이 셸을 거쳐 서버에 전달하므로, 따옴표·$·백틱·개행이 섞이면 어딘가에서
# 조용히 잘린다. 62^32 ≈ 2^190 으로 여유는 충분하다.

say "[3/6] 새 비밀번호를 생성합니다 (화면에 출력하지 않습니다)"

NEW_PASSWORD=""
for _ in 1 2 3 4 5; do
  candidate="$(LC_ALL=C openssl rand -base64 96 | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-32)"
  if [ "${#candidate}" -ge 24 ] && printf '%s' "$candidate" | grep -Eq '^[A-Za-z0-9]+$'; then
    NEW_PASSWORD="$candidate"
    break
  fi
done
[ -n "$NEW_PASSWORD" ] || die "영숫자 24자 이상을 생성하지 못했습니다 (openssl 출력 확인)."
say "  ✓ 영숫자 ${#NEW_PASSWORD}자"

# ── 4. 백업 ───────────────────────────────────────────────────────────────────

say "[4/6] 백업"
cp -p "$ENV_FILE" "$BACKUP"
chmod 600 "$BACKUP"
BACKUP_SHA="$(shasum -a 256 "$BACKUP" | awk '{print $1}')"
[ "$BACKUP_SHA" = "$WHOLE_SHA" ] || die "백업이 원본과 다릅니다. 교체하지 않았습니다. 원본은 그대로입니다."
say "  ✓ $BACKUP (원본과 바이트 동일)"

# ── 5. 교체 + 검증 ────────────────────────────────────────────────────────────
#
# 비밀값은 awk 의 **환경**으로 넘긴다. 인자로 넘기면 실행 중 `ps` 에 보인다.

say "[5/6] ADMIN_PASSWORD 줄을 교체하고 검증합니다"

NEW_PASSWORD="$NEW_PASSWORD" awk '
  BEGIN { replaced = 0 }
  /^ADMIN_PASSWORD=/ && !replaced {
    print "ADMIN_PASSWORD=" ENVIRON["NEW_PASSWORD"]; replaced = 1; next
  }
  { print }
  END { if (!replaced) print "ADMIN_PASSWORD=" ENVIRON["NEW_PASSWORD"] }
' "$ENV_FILE" > "$STAGED"

chmod "$FILE_MODE" "$STAGED" 2>/dev/null || chmod 600 "$STAGED"

AFTER_OTHER_SHA="$(other_sha "$STAGED")"
AFTER_LINES="$(line_count "$STAGED")"
AFTER_KEYS="$(key_count "$STAGED")"

if [ "$BEFORE_KEYS" -eq 1 ]; then
  EXPECTED_LINES="$BEFORE_LINES"
else
  EXPECTED_LINES="$((BEFORE_LINES + 1))"
  say "  ADMIN_PASSWORD 줄이 없었으므로 마지막에 추가했습니다."
fi

fail_staged() {
  say ""
  say "✗ $1"
  say "  교체하지 않았습니다. $ENV_FILE 은 손대지 않은 상태입니다."
  say "  검토용 파일을 남겨 둡니다: $STAGED"
  say "  (확인 후 사람이 직접 지우세요 — 이 스크립트는 파일을 삭제하지 않습니다.)"
  exit 1
}

[ "$AFTER_OTHER_SHA" = "$BEFORE_OTHER_SHA" ] \
  || fail_staged "ADMIN_PASSWORD 이외의 줄이 바뀌었습니다 (SHA-256 불일치)."
[ "$AFTER_LINES" = "$EXPECTED_LINES" ] \
  || fail_staged "줄 수가 다릅니다 (기대 $EXPECTED_LINES, 실제 $AFTER_LINES)."
[ "$AFTER_KEYS" = "1" ] \
  || fail_staged "ADMIN_PASSWORD 줄이 1개가 아닙니다 (실제 $AFTER_KEYS 개)."

STAGED_VALUE_LEN="$(awk -F= '/^ADMIN_PASSWORD=/ { print length(substr($0, index($0, "=") + 1)) }' "$STAGED")"
[ "$STAGED_VALUE_LEN" = "${#NEW_PASSWORD}" ] \
  || fail_staged "기록된 값의 길이가 생성한 길이와 다릅니다 ($STAGED_VALUE_LEN vs ${#NEW_PASSWORD})."

say "  ✓ 다른 줄 SHA-256 동일 · 줄 수 $AFTER_LINES · ADMIN_PASSWORD 1줄 · 값 ${STAGED_VALUE_LEN}자"
[ "$ADDS_NEWLINE" = "1" ] && say "  (마지막 줄 개행 1바이트 추가)"

mv "$STAGED" "$ENV_FILE"
say "  ✓ 교체 완료"

# ── 6. 클립보드 ───────────────────────────────────────────────────────────────

say "[6/6] 클립보드"
if printf '%s' "$NEW_PASSWORD" | $PBCOPY; then
  say "  ✓ 새 비밀번호를 클립보드에 복사했습니다 (화면에는 출력하지 않습니다)"
  say ""
  say "  🔴 Bitwarden 에 지금 저장하세요. 클립보드는 다음 복사 한 번으로 사라집니다."
  say "     저장하지 않으면 되돌리는 방법은 백업 파일뿐입니다:"
  say "       $BACKUP"
else
  say "  ⚠ 클립보드 복사에 실패했습니다."
  say "    새 값은 $ENV_FILE 의 ADMIN_PASSWORD 줄에 있습니다. 직접 열어 Bitwarden 에"
  say "    옮긴 뒤 터미널 스크롤백을 비우세요."
fi

# ── DEPLOY ────────────────────────────────────────────────────────────────────
#
# 파일을 바꾼 것만으로는 아무것도 바뀌지 않는다 — 서버는 여전히 옛 값을 들고 있다.
#
# ⚠ 이 스크립트는 개발 폴더에서 `kamal deploy` 를 돌리지 않는다.
#   ~/.claude/CLAUDE.md 「배포 폴더 분리」: 운영 배포는 ~/Projects/docpack-deploy
#   에서만 하고, 개발 폴더·worktree 에서 하지 않는다. 지시서는 "y 면 kamal deploy
#   실행" 이었지만, 배포 전용 폴더가 없으면 그 실행 자체가 금지된 동작이다.
#   그래서 y 의 동작은 "폴더가 있으면 그 폴더에서 배포, 없으면 만들라고 안내" 다.

say ""
printf '지금 배포할까요? (y/N) '
ANSWER=""
read -r ANSWER || ANSWER=""

deploy_instructions() {
  say ""
  say "배포하지 않았습니다. 서버는 아직 옛 비밀번호로 동작합니다."
  say ""
  if [ -d "$DEPLOY_DIR" ]; then
    say "  배포 전용 폴더로 이동:"
    say "    cd $DEPLOY_DIR"
    say ""
    say "  배포 (한 줄):"
    say "    git fetch && git checkout --detach $(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo HEAD) && git status --porcelain | head -1 && kamal deploy"
  else
    say "  ⚠ 배포 전용 폴더가 없습니다: $DEPLOY_DIR"
    say "    개발 폴더에서 배포하지 않습니다(전역 규칙). 먼저 폴더를 만드세요:"
    say ""
    say "    git clone $ROOT $DEPLOY_DIR"
    say ""
    say "    그 폴더의 비밀값은 개발 폴더 것을 심볼릭 링크로 씁니다(복사 금지):"
    say "    ln -s $ROOT/.env.production.local $DEPLOY_DIR/.env.production.local"
  fi
}

case "$ANSWER" in
  y|Y)
    if [ ! -d "$DEPLOY_DIR" ]; then
      say ""
      say "✗ 배포 전용 폴더가 없어 배포하지 않았습니다: $DEPLOY_DIR"
      deploy_instructions
      exit 0
    fi
    DEPLOY_DIRTY="$(git -C "$DEPLOY_DIR" status --porcelain 2>/dev/null | head -1 || true)"
    if [ -n "$DEPLOY_DIRTY" ]; then
      say ""
      say "✗ $DEPLOY_DIR 에 커밋되지 않은 변경이 있습니다. 배포하지 않았습니다."
      say "  그 폴더에서는 코드 수정을 하지 않습니다 — 내용을 확인한 뒤 다시 실행하세요."
      exit 1
    fi
    say ""
    say "→ $DEPLOY_DIR 에서 kamal deploy"
    ( cd "$DEPLOY_DIR" && kamal deploy )
    say ""
    say "배포 후 확인 (비밀번호를 출력하지 않는 방법):"
    say "  1) https://slimfile.net/admin/login 에서 새 비밀번호로 로그인"
    say "  2) 옛 비밀번호로 로그인 → '비밀번호가 올바르지 않습니다.' 가 나와야 합니다"
    ;;
  *)
    deploy_instructions
    ;;
esac

say ""
say "끝. 백업: $BACKUP"
