<%# Moved here from PostsController#index (2026-09-17). content_for set through a
    controller's `helpers` proxy never reaches the rendered layout, so the call
    was a silent no-op and all four /blog listings shipped the default
    "SlimFile" <title> with the generic site description — measured live before
    the move. Same trap as posts/show.html.erb; keep page_meta in the view. %>
<%# ── which publication is this? (S11) ─────────────────────────────────────
    /ja/blog is the SafeFile JP track; /blog, /en/blog and /es/blog are the
    Korean one (PostsController#index already scopes the rows that way). Until
    now the two shared one <title> and one meta description, both of which
    described the Korean blog — so the Japanese listing told Google it was
    about 「画像圧縮、PDF変換、ファイル最適化」.

    Keyed on url_locale, not I18n.locale: /blog read with a `locale=ja` cookie
    is still the Korean blog, and its identity has to be a property of the URL.
    The strings are requested with an explicit `locale: :ja` so they cannot
    fall back into another language — this listing is a Japanese publication
    whichever UI language the reader has remembered. %>
<% jp_track = url_locale == :ja %>
<% jp_t = ->(key) { t("blog.jp.#{key}", locale: :ja) } %>

<% if jp_track %>
  <% page_meta(title: jp_t.("title"), description: jp_t.("meta_description"), path: "/blog") %>
  <%# og:site_name follows the publication, not the site (S12). The articles in
      this listing declare publisher/author = SafeFile, so a listing that calls
      itself SlimFile would put a third name on the same JP surface. %>
  <% content_for :og_site_name, "SafeFile" %>
<% else %>
  <% page_meta(
       title: t("blog.title"),
       description: t("blog.meta_description"),
       path: "/blog"
     ) %>
<% end %>

<% if jp_track %>
  <%# CollectionPage — the listing is what an answer engine lands on when it
      wants "the SafeFile JP articles", and it had no structured data at all
      (audit 2026-11-02). mainEntity is an ItemList of the posts actually
      rendered below, so the markup cannot describe entries the page does not
      show. Built as a Hash and serialised with to_json for the same reason as
      the FAQ block in posts/show.html.erb: a title containing a quote would
      otherwise produce invalid JSON-LD, and Google drops it silently. %>
  <% collection_ld = {
       "@context" => "https://schema.org",
       "@type" => "CollectionPage",
       "name" => jp_t.("heading"),
       "description" => jp_t.("meta_description"),
       "url" => "#{base_url}/ja/blog",
       "inLanguage" => "ja",
       "isPartOf" => {
         "@type" => "WebSite",
         "name" => "SafeFile",
         "url" => "#{base_url}/safe/"
       },
       "publisher" => {
         "@type" => "Organization",
         "name" => "SafeFile",
         "url" => "#{base_url}/safe/",
         "logo" => { "@type" => "ImageObject", "url" => "#{base_url}/safe/brand/icon-512.png" }
       },
       "mainEntity" => {
         "@type" => "ItemList",
         "numberOfItems" => @posts.size,
         "itemListElement" => @posts.each_with_index.map do |post, i|
           {
             "@type" => "ListItem",
             "position" => i + 1,
             "url" => "#{base_url}/ja/blog/#{post.slug}",
             "name" => post.title(:ja).to_s
           }
         end
       }
     } %>
  <% content_for :head do %>
    <script type="application/ld+json">
    <%= collection_ld.to_json.gsub("</", "<\\/").html_safe %>
    </script>
  <% end %>
<% end %>

<div class="container">
  <div class="page-header">
    <div class="page-header-icon" style="background: var(--compress-light);">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--compress)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
    </div>
    <div>
      <h1><%= jp_track ? jp_t.("heading") : t("blog.heading") %></h1>
      <p class="page-desc"><%= jp_track ? jp_t.("description") : t("blog.description") %></p>
    </div>
  </div>

<% if jp_track %>
  <%# S11 item 4b. The three landing pages were orphans — no indexed page
      linked to them, which is the textbook cause of the "Discovered –
      currently not indexed" state all four JP URLs were in on 2026-11-02.
      Here rather than in the footer because a reader arriving on the listing
      is choosing by PURPOSE, which is exactly what the three pages split on.
      No ?via= parameter: internal navigation, and there is no `via` value
      meaning "from our own blog listing" — see the note in /safe/'s footer. %>
  <h2 class="jp-landing-heading"><%= jp_t.("landings_heading") %></h2>
  <div class="jp-landing-cards">
    <a class="jp-landing-card" href="/safe/jp/nyusatsu/">
      <strong>入札添付</strong>
      <span>公共工事の入札に添える資格確認書・保険証の写し。保険者番号・記号・番号・枝番を隠し、氏名と事業所名は残す。</span>
    </a>
    <a class="jp-landing-card" href="/safe/jp/honnin-kakunin/">
      <strong>本人確認書類</strong>
      <span>銀行・カード・通信・フリマ。免許証やマイナンバーカードの、求められていない面と項目だけを隠す。</span>
    </a>
    <a class="jp-landing-card" href="/safe/jp/ai-mae/">
      <strong>AIに貼る前に</strong>
      <span>契約書や給与明細をAIに相談するとき。条文と金額は残し、相手方の氏名・住所・口座を隠す。</span>
    </a>
  </div>
<% end %>

  <div class="blog-categories">
    <%= link_to t("blog.all"), blog_path, class: "blog-cat-chip #{params[:category].blank? ? 'blog-cat-chip--active' : ''}" %>
    <% %w[privacy image pdf office student freelancer global].each do |cat| %>
      <%= link_to t("blog.categories.#{cat}"), blog_path(category: cat), class: "blog-cat-chip #{params[:category] == cat ? 'blog-cat-chip--active' : ''}" %>
    <% end %>
  </div>

  <% if @posts.any? %>
    <div class="blog-grid">
      <% @posts.each do |post| %>
        <article class="blog-card">
          <% if post.cover_svg.present? %>
            <div class="blog-card-cover"><%= post.cover_svg.html_safe %></div>
          <% else %>
            <div class="blog-card-cover blog-card-cover--placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--compress)" stroke-width="1.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
          <% end %>
          <div class="blog-card-body">
            <span class="blog-card-cat"><%= t("blog.categories.#{post.category}") %></span>
            <h2 class="blog-card-title"><%= link_to post.title(url_locale), blog_post_path(slug: post.slug) %></h2>
            <p class="blog-card-desc"><%= truncate(post.meta_description(url_locale).to_s, length: 100) %></p>
            <time class="blog-card-date"><%= post.published_at&.strftime("%Y.%m.%d") %></time>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="blog-empty">
      <p><%= jp_track ? jp_t.("empty") : t("blog.empty") %></p>
    </div>
  <% end %>

  <% if params[:category].present? %>
    <div class="blog-back-to-all">
      <%= link_to "#{t('blog.view_all')} →".html_safe, blog_path, class: "blog-back-to-all-link" %>
    </div>
  <% end %>
</div>
