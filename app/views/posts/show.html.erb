<%# Page meta must be emitted from the view: content_for set via the controller's
    `helpers` proxy does not propagate to the layout head. %>
<%# @url_locale, not I18n.locale — the canonical must follow the URL, not the
    reader's cookie/Accept-Language. See PostsController#show. %>
<%# Post#canonical_path_for folds in which locale the post was WRITTEN in. For a
    Korean post it computes exactly what the old inline expression did — its
    primary locale is the unprefixed one — so none of the 42 live posts move
    (E-1, test/integration/blog_seo_snapshot_test.rb). For a Japanese post the
    untranslated fallback is /ja/blog/:slug rather than /blog/:slug, which is a
    301. %>
<% canonical_path = @post.canonical_path_for(@url_locale) %>
<%# Content follows @url_locale too, not just the canonical. Reading I18n.locale
    here meant an unprefixed URL served an English title/description/body to an
    `Accept-Language: en` request while pointing its canonical at the Korean
    address — the same content as /en/blog/:slug at a second URL. %>
<% page_meta(
     title: @post.title(@url_locale),
     description: @post.meta_description(@url_locale).presence || @post.title(@url_locale),
     canonical: canonical_path
   ) %>
<%# Not @post_translated: a draft or scheduled post is 200 for preview but must
    never be indexed either. See Post#indexable? for the full signal table. %>
<%# ONE value, computed — not two content_for calls. `content_for` APPENDS, so
    a draft rendered through the admin preview (both conditions true) would
    emit the single mangled directive "noindex,follownoindex,nofollow", and a
    malformed robots value is ignored rather than rejected: the page would be
    indexable and the tag would look like it was doing its job.

    The admin preview (S9) is never indexable, whatever the post's state is.
    @post_indexable already covers a draft, but this URL must stay noindex even
    after the episode is published and its real address becomes indexable —
    otherwise /admin/jp/packages/2/preview is a second address serving the same
    article, the duplicate shape this repository has been penalised for twice.
    `nofollow` as well, because there is no reason to walk an admin page's links.

    E-1 is unaffected: @preview is nil on every public request, so the
    directive emitted at /blog/:slug and /ja/blog/:slug does not move. %>
<% robots = if @preview
              "noindex,nofollow"
            elsif !@post_indexable
              "noindex,follow"
            end %>
<% content_for :robots, robots if robots %>

<%# og:site_name for the JP track (S12). Keyed on primary_locale, the language
    the article WAS WRITTEN IN — not on @url_locale. /en/blog/:slug serves the
    English edition of a Japanese episode, and the publisher of that edition is
    still SafeFile; keying on the URL would have the same article change
    publishers depending on which of its addresses you opened.

    Korean posts leave it unset, so the layout emits "SlimFile" exactly as
    before and the 42 live posts' <head> does not move (E-1). %>
<% content_for :og_site_name, "SafeFile" if @post.primary_locale == "ja" %>

<% content_for :head do %>
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="<%= @post.published_at&.iso8601 %>">
  <meta property="article:modified_time" content="<%= @post.updated_at&.iso8601 %>">
  <meta property="article:section" content="<%= @post.category %>">
  <% if @post.hero_image.attached? %>
    <% content_for :meta_image, url_for(@post.hero_image) %>
  <% end %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "<%= j @post.title(@url_locale) %>",
    "description": "<%= j(@post.meta_description(@url_locale).to_s) %>",
    <%# canonical_path, not a hardcoded /blog/:slug — on /en/blog/:slug the
        canonical says /en/... while these said /... , so the page and its
        structured data named two different documents. Same rule as the rest of
        the indexing signals: derive it from the URL. %>
    "url": "<%= base_url %><%= canonical_path %>",
    "datePublished": "<%= @post.published_at&.iso8601 %>",
    "dateModified": "<%= @post.updated_at&.iso8601 %>",
    <%# The language of the DOCUMENT at this URL is the locale the canonical
        above resolves to, not @url_locale: on an untranslated /es URL the page
        serves the primary-locale text, so claiming inLanguage=es would describe
        a translation that does not exist.

        S8 emitted this for the JP track only, and said why: the requirement
        that round was that the 42 live Korean posts not move by one character,
        and a new field in their structured data is a change. S9 is the separate
        auditable step that was promised — the Korean track now says `ko`.

        Derived from the canonical path rather than from primary_locale, which
        is what makes one expression cover both tracks: /en/blog/:slug is `en`
        whichever track the post belongs to, a Japanese post's own address is
        `ja`, and a Korean post's unprefixed address is `ko`.

        E-1 (test/integration/blog_seo_snapshot_test.rb) captures canonical,
        robots, hreflang, og:locale and html lang from the rendered HTML — not
        JSON-LD — so all 38 rows are expected to be byte-identical. That is
        asserted rather than assumed, and the JSON-LD change has its own test:
        a snapshot that cannot see a field cannot protect it. %>
    "inLanguage": "<%= canonical_path.start_with?("/en/") ? "en" : @post.primary_locale %>",
    <% if @post.hero_image.attached? %>
    "image": "<%= url_for(@post.hero_image) %>",
    <% end %>
    <%# `author` follows `publisher` onto SafeFile for the JP track (S12).

        S11b renamed the publisher and left this one, so a Japanese article
        declared publisher=SafeFile and author=SlimFile in the SAME JSON-LD
        object — the two-names-for-one-entity problem S11b set out to fix,
        reproduced one key lower. An answer engine reading the block has no way
        to tell whether SafeFile published SlimFile's article or the two are the
        same organisation.

        Same ternary shape as `publisher` below and for the same reason: this
        changes the SOURCE, not the Korean OUTPUT. The 42 live Korean posts
        still emit the identical three lines, which jp_geo_surface_test asserts
        directly — E-1 cannot see JSON-LD, so a snapshot cannot protect it. %>
    "author": {
      "@type": "Organization",
      "name": "<%= @post.primary_locale == "ja" ? "SafeFile" : "SlimFile" %>"
    },
    <%# `logo` on the JP track only (S11).

        The 2026-11-02 audit found no publisher logo anywhere in the site's
        structured data, which is a documented requirement for Google's Article
        rich result. Adding it to the Korean track as well would be a change to
        the 42 live Korean posts' markup, and this round's standing rule is that
        they do not move — so the JP branch gets it and the Korean one emits
        exactly the three lines it emitted before. E-1 cannot see this (it does
        not capture JSON-LD), so there is a separate test that reads the Korean
        block and asserts the key is absent: a snapshot that cannot see a field
        cannot protect it.

        2026-11-02 Justin decision: the JP track's publisher is **SafeFile**
        (S11 §12 item 1). S11 left `name` as "SlimFile" while the Organization
        block on the landing pages named SafeFile and this logo was SafeFile's
        icon — one entity described under two names, which is precisely what an
        answer engine reading both cannot reconcile. The JP branch now says
        SafeFile; the Korean branch still emits the exact three lines it emitted
        before, so the 42 live Korean posts do not move by one byte. The ternary
        changes the SOURCE but not the Korean OUTPUT — which is what E-1 and the
        dedicated publisher test measure. %>
    "publisher": {
      "@type": "Organization",
      "name": "<%= @post.primary_locale == "ja" ? "SafeFile" : "SlimFile" %>",
      "url": "<%= base_url %>"<% if @post.primary_locale == "ja" %>,
      "logo": {
        "@type": "ImageObject",
        "url": "<%= base_url %>/safe/brand/icon-512.png"
      }<% end %>
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "<%= base_url %><%= canonical_path %>"
    }
  }
  </script>
  <%# FAQPage — only when the page really renders a FAQ section. An empty or
      absent list emits nothing: structured data that announces a section the
      document does not contain is a claim about the page that is false, and
      Google treats it as a markup violation rather than as a missing optional.
      Only the JP track carries one (package.faq, three entries, written in
      faq_ja.md and imported by content:jp_import). %>
  <% if @faq.present? %>
  <%# Built as a Ruby Hash and serialised with to_json rather than assembled by
      string interpolation: a question containing a quote, a backslash or a
      newline would otherwise produce invalid JSON-LD, and the failure is
      silent (Google just drops the block).
      Script-context safety comes from two layers, and the first one is already
      doing the work: Rails sets escape_html_entities_in_json, so to_json emits
      "<" as < and a hostile "</script>" never appears literally.
      Probed with `</script><img src=x onerror=…>` as a question: the block
      still parsed as JSON and no <img> reached the document. The gsub is the
      second layer — it keeps this correct if that setting is ever turned off,
      and "<\/" is valid JSON either way. %>
  <% faq_ld = {
       "@context" => "https://schema.org",
       "@type" => "FAQPage",
       "mainEntity" => @faq.map do |e|
         {
           "@type" => "Question",
           "name" => e["q"].to_s,
           "acceptedAnswer" => { "@type" => "Answer", "text" => e["a"].to_s }
         }
       end
     } %>
  <script type="application/ld+json">
  <%= faq_ld.to_json.gsub("</", "<\\/").html_safe %>
  </script>
  <% end %>
  <%# BreadcrumbList — JP track only (S11).

      ホーム › ブログ › 記事. The Korean track does not get one for the same
      reason as the publisher logo above: its markup does not move this round.

      ⚠️ S11 made the trail follow the CANONICAL prefix, so a Japanese episode
      with a body_en got ホーム › Blog pointing at /en and /en/blog. The
      2026-11-04 cross-review rated that AMBER and it was right: /en/blog is a
      DIFFERENT PUBLICATION. PostsController#index scopes the listing by track
      — /ja/blog serves Post.jp, while /blog, /en/blog and /es/blog serve the
      Korean posts — so the old trail said this article's parent index was one
      that does not and will never list it. A breadcrumb is a claim about where
      a document sits in the site, and that claim was false.
      The rungs are therefore fixed on /ja, which is where this publication
      lives, for every JP episode whatever its canonical prefix. Mixing the
      prefixes would be worse than either: Home on /en with Blog on /ja/blog
      describes a hierarchy that exists nowhere.
      The LABELS still follow the page's language — an English article gets
      "Home › Blog" — because the reader of that page reads English. The names
      are a courtesy to the reader; the URLs are a factual claim, and only the
      second one has to match the site.
      Both rungs resolve (jp_geo_surface_test fetches them), which is the
      mistake the hreflang work in this repository has already made twice.

      Only two rungs carry `item`. The last one is the current page and Google
      asks that it be left without a URL; naming itself would make the page its
      own ancestor. %>
  <% if @post.primary_locale == "ja" %>
    <% bc_en = canonical_path.start_with?("/en/") %>
    <% bc_prefix = "/ja" %>
    <% breadcrumb_ld = {
         "@context" => "https://schema.org",
         "@type" => "BreadcrumbList",
         "itemListElement" => [
           { "@type" => "ListItem", "position" => 1,
             "name" => bc_en ? "Home" : "ホーム",
             "item" => "#{base_url}#{bc_prefix}" },
           { "@type" => "ListItem", "position" => 2,
             "name" => bc_en ? "Blog" : "ブログ",
             "item" => "#{base_url}#{bc_prefix}/blog" },
           { "@type" => "ListItem", "position" => 3,
             "name" => @post.title(@url_locale).to_s }
         ]
       } %>
  <script type="application/ld+json">
  <%= breadcrumb_ld.to_json.gsub("</", "<\\/").html_safe %>
  </script>
  <% end %>
<% end %>

<%# The JP track renders its own article shell and returns. Everything below is
    the Korean marketing-page layout (hardcoded Korean CTAs, loss box, stats
    cards, "블로그 목록으로") and is left exactly as it was — branching here
    rather than threading conditionals through 140 lines keeps the Korean path
    off the diff entirely, which is what E-1 is asking for. %>
<% if @post.primary_locale == "ja" %>
  <%= render "posts/jp_article", post: @post, url_locale: @url_locale, faq: @faq %>
<% else %>

<% if @post.trust_bar.present? %>
<div class="blog-trust-bar">
  <%= @post.trust_bar %>
</div>
<% end %>

<div style="max-width: 640px; margin: 0 auto; padding: 2rem 1.25rem;">
  <%# Pain Tag %>
  <div class="blog-pain-tag"><%= @post.pain_tag.presence || @post.category.upcase %></div>

  <%# 제목 %>
  <h1 style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 6px;"><%= @post.title(@url_locale) %></h1>
  <% if @post.subtitle_ko.present? %>
    <p class="blog-subhead"><%= @post.subtitle_ko %></p>
  <% end %>

  <%# Meta %>
  <div class="blog-meta">
    <span><%= @post.published_at&.strftime("%Y.%m.%d") %></span>
    <span><%= t("blog.views", count: @post.view_count) %></span>
  </div>

  <%# Hero Image %>
  <% if @post.hero_image.attached? %>
    <div style="margin-bottom: 24px; border-radius: 14px; overflow: hidden; border: 0.5px solid #E5E3DC;">
      <%= image_tag @post.hero_image, style: "width: 100%; height: auto; display: block;", alt: @post.title_ko %>
    </div>
  <% end %>

  <%# Error Mockup %>
  <% if @post.error_mockup.present? %>
    <% mockup = begin; JSON.parse(@post.error_mockup); rescue; nil; end %>
    <% if mockup %>
    <div class="blog-error-mockup">
      <div class="blog-browser-bar">
        <div class="blog-browser-dots">
          <div class="blog-dot blog-dot-r"></div>
          <div class="blog-dot blog-dot-y"></div>
          <div class="blog-dot blog-dot-g"></div>
        </div>
        <div class="blog-url-bar"><%= mockup['url_bar'] %></div>
      </div>
      <div class="blog-error-body">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">
          <div style="width:30px;height:30px;background:<%= mockup['service_icon_color'] %>;border-radius:7px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;font-weight:800;flex-shrink:0">
            <%= mockup['service_icon_letter'] %>
          </div>
          <div>
            <strong style="display:block;font-size:14px;font-weight:700"><%= mockup['service_name'] %></strong>
          </div>
        </div>
        <div class="blog-error-alert">
          <div class="blog-error-icon">&#9888;</div>
          <div>
            <span class="blog-error-title"><%= mockup['error_title'] %></span>
            <p class="blog-error-desc"><%= mockup['error_desc'] %></p>
          </div>
        </div>
        <div class="blog-file-row">
          <div class="blog-file-icon">PDF</div>
          <div>
            <span class="blog-file-name"><%= mockup['file_name'] %></span>
            <span class="blog-file-date">방금 작성</span>
          </div>
          <div class="blog-size-badge"><%= mockup['size_label'] %></div>
        </div>
      </div>
    </div>
    <p style="text-align:center;font-size:12px;color:#6B6963;margin-bottom:24px;font-style:italic">많은 분들이 경험하는 바로 그 상황입니다.</p>
    <% end %>
  <% end %>

  <%# Recognition %>
  <% if @post.recognition_text.present? %>
  <div class="blog-recognition">
    <%= @post.recognition_text %>
  </div>
  <% end %>

  <%# Loss Box %>
  <% if @post.loss_items.present? %>
    <% items = begin; JSON.parse(@post.loss_items); rescue; []; end %>
    <% if items.any? %>
    <div class="blog-loss-box">
      <div class="blog-loss-title">지금 이 문제를 방치하면 잃게 되는 것</div>
      <ul>
        <% items.each do |item| %>
        <li>
          <div class="blog-loss-dot"></div>
          <span><%= item %></span>
        </li>
        <% end %>
      </ul>
    </div>
    <% end %>
  <% end %>

  <%# CTA #1 %>
  <a href="https://slimfile.net" class="blog-cta-inline-v2">
    <div class="blog-cta-inline-text">
      <strong>지금 바로 해결하기</strong>
      <span>무료 &middot; 회원가입 불필요 &middot; 30초 완료</span>
    </div>
    <div class="blog-cta-inline-btn">압축 시작 &rarr;</div>
  </a>

  <%# Stats %>
  <% if @post.stats.present? %>
    <% stats = begin; JSON.parse(@post.stats); rescue; []; end %>
    <% if stats.any? %>
    <div class="blog-stats-v2">
      <% stats.each do |stat| %>
      <div class="blog-stat-card">
        <div class="blog-stat-num"><%= stat['num'] %></div>
        <div class="blog-stat-label"><%= stat['label'] %></div>
      </div>
      <% end %>
    </div>
    <% end %>
  <% end %>

  <%# 본문 HTML (cause, steps, ba, situations, checklist, faq) %>
  <div class="blog-post-body">
    <%= @post.body(@url_locale).to_s.html_safe %>
  </div>

  <%# CTA #2 %>
  <div class="blog-cta-bottom-v2">
    <h3>지금 바로 해결하세요</h3>
    <p>무료 &middot; 회원가입 불필요 &middot; 30초 완료 &middot; 오늘 수천 명이 이미 사용 중</p>
    <div class="blog-btn-group">
      <a href="https://slimfile.net/compress" class="blog-btn-primary">이미지 압축 시작 &rarr;</a>
      <a href="https://slimfile.net/pdf" class="blog-btn-secondary">PDF 변환하기</a>
    </div>
  </div>

  <div style="text-align:center;margin-top:20px">
    <a href="/blog" style="font-size:13px;color:#6B6963;text-decoration:none">&larr; 블로그 목록으로</a>
  </div>
</div>
<% end %>
