# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Never ship these into the production image (2026-10-25, S8).
#
# public/safe/작업물/ sits UNDER public/, so anything in it is served by
# ActionDispatch::Static at a guessable URL the moment the image is deployed —
# it is not a private directory, it is an unlisted public one. The folder's
# provenance is unconfirmed (see CLAUDE.md «public/safe/작업물/ 정체 확인 필요»),
# so it is excluded from the build rather than deleted: an exclusion is
# reversible and a delete is not.
/public/safe/작업물/

# docs/jp/private/ holds the named pilot prospect list. It is gitignored, but
# `COPY . .` copies the working tree, not the git index — so without this line
# the file would ride into every production image built on this machine.
/docs/jp/private/
